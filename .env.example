# === Server-side (Vercel env vars — NEVER exposed to the browser) ===

# Neon Postgres connection string (Neon dashboard → Connection Details).
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare Turnstile secret key (server verification). Leave empty in dev.
TURNSTILE_SECRET_KEY=

# Long random string used to hash IPs before storage (no raw IP is ever kept).
IP_HASH_SALT=change-me-to-a-long-random-string

# === Client-side (VITE_ prefix = bundled into the browser) ===

# Set to 1 on Vercel so the client talks to /api/* instead of the demo store.
# Leave UNSET for local `vite dev` (runs in offline demo mode).
VITE_USE_API=1

# Cloudflare Turnstile public site key (anti-bot widget).
VITE_TURNSTILE_SITE_KEY=
